# --- Zorunlu ---
# Neon (Vercel Marketplace) veya lokal Postgres.
# Lokal: postgresql://<kullanici>@localhost:5432/concertio
DATABASE_URL=

# Last.fm API key — https://www.last.fm/api/account/create (ucretsiz)
LASTFM_API_KEY=

# Ticketmaster Discovery API key — https://developer.ticketmaster.com (ucretsiz, 5000/gun)
TICKETMASTER_API_KEY=

# --- Zorunlu: MusicBrainz anlamli User-Agent istiyor (1 istek/sn) ---
MUSICBRAINZ_USER_AGENT=concertio/0.1 ( senin@mailin.com )

# --- Faz 0 icin ---
CONCERTIO_LASTFM_USER=yeterli

# --- Opsiyonel (Faz 1) ---
SEATGEEK_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Konum ozelligini acar; en az 16 karakter, "openssl rand -hex 24" ile uret
CONCERTIO_EDIT_SECRET=
